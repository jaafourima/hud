# Copy to .env and fill in. Use hex passwords (openssl rand -hex 24) so they are URL-safe.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Address the server and Grafana listen on. Default: this machine only.
HUD_BIND_ADDR=127.0.0.1
# Let more people create accounts. The first account can always be created.
HUD_ALLOW_REGISTRATION=false
# Filled in after running deploy/grafana_access.py:
HUD_GRAFANA_DB_USER=
HUD_GRAFANA_DB_PASSWORD=
